    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.2",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^3.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "validator": "^13.15.26",
    "zod": "^4.3.6"
