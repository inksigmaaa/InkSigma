# Server Configuration
PORT=5000
NODE_ENV=development

# Backend URL (used for generating image URLs, etc.)
BACKEND_URL=http://localhost:5000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/inksigma

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
# Either set RESEND_FROM directly, or set RESEND_FROM_EMAIL plus optional RESEND_FROM_NAME.
RESEND_FROM="InkSigma <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=InkSigma
RESEND_OPERATION_TIMEOUT_MS=8000
RESEND_MAX_CONCURRENCY=5

# Authentication
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:5000
TOKEN_HASH_SECRET=your-token-hash-secret-here

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain Configuration
BASE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:3000
CUSTOM_DOMAIN_IP_TARGET=
CUSTOM_DOMAIN_IP_TARGETS=
CUSTOM_DOMAIN_CNAME_TARGET=
CUSTOM_DOMAIN_CNAME_TARGETS=
CUSTOM_DOMAIN_MULTI_LABEL_SUFFIXES=
CUSTOM_DOMAIN_REACHABILITY_TIMEOUT_MS=8000
VERCEL_TOKEN=
VERCEL_PROJECT_ID_OR_NAME=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
VERCEL_API_TIMEOUT_MS=8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Feature Flags
VALIDATE_EMAIL_MX=false
