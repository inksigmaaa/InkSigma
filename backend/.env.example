# Server Configuration
PORT=5000
NODE_ENV=development

# Backend URL (used for generating image URLs, etc.)
BACKEND_URL=http://localhost:5000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/inksigma

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=InkSigma

# Authentication
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:5000

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain Configuration
BASE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Voice Transcription (Groq Speech-to-Text)
GROQ_API_KEY=
TRANSCRIPTION_MAX_FILE_MB=25

# Feature Flags
VALIDATE_EMAIL_MX=false
