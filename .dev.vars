# Cloudflare Workers local dev secrets — DO NOT COMMIT
# These are loaded by `wrangler dev` / `npm run preview`
# Copy this file, fill in real values, never push to git

NEXTJS_ENV=development
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com
NEXT_PUBLIC_SAME_ORIGIN_DASHBOARD=true

# Server-side secrets (replace with real values)
BETTER_AUTH_SECRET=your-dev-secret-here
DATABASE_URL=postgresql://user:password@host/dbname
RESEND_API_KEY=re_xxxx
